{
  "expo": {
    "name": "Martino Noir",
    "slug": "martinonoir",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/expo/splash-icon.png",
    "scheme": "martinonoir",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.martinonoir.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.martinonoir.mobile",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "martinonoir"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/expo/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0A0A0A",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Martinonoir to save product images to your photos.",
          "savePhotosPermission": "Allow Martinonoir to save product images to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.martinonoir.com/api/v1",
      "siteUrl": "https://martinonoir.com",
      "router": {},
      "eas": {
        "projectId": "0dc4ec62-8111-4816-b537-aed0253d077c"
      }
    }
  }
}
